# ── LLM backend ───────────────────────────────────────────────────────────────
# Default (no config): uses the local `claude` CLI on your Max plan — no API billing.
# To force a backend, set LLM_BACKEND to one of: cli | api | fixture
# LLM_BACKEND=cli

# If set, the API backend is used instead of the CLI (requires @anthropic-ai/sdk).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model override for either backend.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000

# Timeout for a single `claude` CLI call (ms).
# CLI_TIMEOUT_MS=180000

# Where run artifacts/state/audit are written.
# DATA_DIR=.data

# Verbose backend logging.
# DEBUG=true
